#!/bin/sh
# lab — a tiny command runner for the Read / Do / Check curriculum.
#
# Instead of copy-pasting long commands, a student types a short token (l1, l1b,
# ...). The runner prints the REAL command (so you learn it), runs it, then shows
# the expected output so you can self-check. Two chars, no clipboard.
#
#   lab <tok>        run a step: print the command, execute it, show Expected
#   lab list         list every step, grouped by level
#   lab check <tok>  show a step's expected output WITHOUT running it
#   lab reset        restart the loopback lab (broker + outstation)
#   lab open         print the Learning Path (:8080) and noVNC (:6080) URLs
#   lab help         this help
#
# Step files + manifests are generated by build/build_lab.py.
set -u

# Resolve ROOT = the parent of the dir holding this script, whether invoked as
# ./lab/lab, /abs/lab/lab, or bare `lab` found on PATH.
SELF="$0"
case "$SELF" in
  */*) : ;;                                   # already a path
  *)   SELF="$(command -v "$SELF" 2>/dev/null || echo "$SELF")" ;;
esac
DIR="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)"
ROOT="$(dirname "$DIR")"
STEPS="$ROOT/lab/steps"
TSV="$ROOT/lab/commands.tsv"
TAB="$(printf '\t')"

usage() {
  cat <<'EOF'
lab — type a short token instead of copy-pasting commands.

  lab <tok>        run a step: prints the real command, runs it, shows Expected
  lab list         list every step, grouped by level
  lab check <tok>  show a step's expected output without running it
  lab reset        restart the loopback lab (broker + outstation)
  lab open         print the Learning Path (:8080) and noVNC (:6080) URLs
  lab help         show this help

Example:  lab l1     (Level 1, first terminal step)   ·   lab list  to see them all.
EOF
}

cmd="${1:-help}"

case "$cmd" in
  ""|help|-h|--help)
    usage
    ;;

  list)
    if [ ! -f "$TSV" ]; then
      echo "no commands.tsv yet — generate it with:  python3 build/build_lab.py" >&2
      exit 2
    fi
    echo "Read / Do / Check — terminal steps you can run by typing the token:"
    lastn=""
    while IFS="$TAB" read -r tok n gist; do
      [ -z "${tok:-}" ] && continue
      if [ "$n" != "$lastn" ]; then
        echo ""
        echo "  Level $n"
        lastn="$n"
      fi
      printf '    %-5s  %s\n' "$tok" "$gist"
    done < "$TSV"
    echo ""
    echo "Type a token (e.g.  l1 ) to run it, or  lab l1 ."
    ;;

  open)
    echo "Learning Path : http://localhost:8080    (curriculum/index.html — the leveled path)"
    echo "noVNC Desktop : http://localhost:6080    (Wireshark, already capturing on lo)"
    echo ""
    echo "The noVNC desktop opens straight to the desktop — no password prompt."
    echo "(If a VNC prompt ever appears, the password is: vscode)"
    ;;

  reset)
    echo "Restarting the loopback lab (broker on 1883 + DNP3 outstation on 20000)..."
    bash "$ROOT/lab/run-local.sh" down
    bash "$ROOT/lab/run-local.sh" up
    ;;

  check)
    tok="${2:-}"
    if [ -z "$tok" ]; then
      echo "usage: lab check <tok>   (e.g. lab check l1)" >&2
      exit 2
    fi
    if [ -f "$STEPS/$tok.check" ]; then
      echo "— Expected output for $tok —"
      cat "$STEPS/$tok.check"
    elif [ -f "$STEPS/$tok" ]; then
      echo "(no expected output recorded for '$tok')"
    else
      echo "unknown step '$tok' — try: lab list" >&2
      exit 2
    fi
    ;;

  *)
    tok="$cmd"
    if [ ! -f "$STEPS/$tok" ]; then
      echo "unknown step '$tok' — try: lab list" >&2
      exit 2
    fi
    echo "▶ $tok runs:"
    sed 's/^/    /' "$STEPS/$tok"
    echo "  ────────────────────────────────────────────────────────"
    ( cd "$ROOT" && sh "lab/steps/$tok" )
    rc=$?
    if [ -f "$STEPS/$tok.check" ]; then
      echo ""
      echo "— Expected —"
      cat "$STEPS/$tok.check"
    fi
    exit $rc
    ;;
esac
